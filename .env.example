# Copy to .env and fill in. Generate secrets with:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 24   (POSTGRES_PASSWORD)
#   openssl rand -base64 32                              (LANGFUSE_NEXTAUTH_SECRET, LANGFUSE_SALT)
#   openssl rand -hex 32                                 (LANGFUSE_ENCRYPTION_KEY)
POSTGRES_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=

# Langfuse API key, provisioned into Langfuse by docker-compose (INIT_* vars)
# and used by the app for tracing and the stats view. Generate with:
#   cat /proc/sys/kernel/random/uuid
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional UI login, created as owner of the provisioned org.
# LANGFUSE_INIT_USER_EMAIL=
# LANGFUSE_INIT_USER_PASSWORD=

# Mistral (generation).
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-14b-latest

# LLM judge for generation eval (OpenAI-compatible).
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=

# Cross-encoder rerank hook, off by default: measured +0.13 MRR@5 on the golden
# set, but 1.7-4.7 s per query on CPU (scripts/rerank-benchmark.sh). Only
# enable on hardware that can afford it.
# RERANK_ENABLED=false

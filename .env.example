# Copy to .env and fill in. Generate secrets with:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 24   (POSTGRES_PASSWORD)
#   openssl rand -base64 32                              (LANGFUSE_NEXTAUTH_SECRET, LANGFUSE_SALT)
#   openssl rand -hex 32                                 (LANGFUSE_ENCRYPTION_KEY)
POSTGRES_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=

# Langfuse API key, provisioned into Langfuse by docker-compose (INIT_* vars)
# and used by the app for tracing and the stats view. Generate each with:
#   cat /proc/sys/kernel/random/uuid
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Mistral (generation), API key required for chat
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-14b-latest


# Optional Langfuse UI login, not needed for RAGnarok app to function. Only necessary to use
# Langfuse dashboard at http://localhost:3001, project `RAGnarok`.
# LANGFUSE_INIT_USER_EMAIL=
# LANGFUSE_INIT_USER_PASSWORD=

# LLM judge for generation eval (OpenAI-compatible).
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=

# Cross-encoder rerank hook, off by default: measured +0.13 MRR@5 on the golden
# set, but up to 5s per query on CPU. Only enable on fast hardware.
# RERANK_ENABLED=false

# Local generation backend (docker compose --profile local). Set
# GENERATION_PROVIDER=local to serve chat from the `inference` service instead
# of Mistral.
GENERATION_PROVIDER=mistral
LOCAL_BASE_URL=http://inference:8080/v1
LOCAL_MODEL=qwen3.5-9b-q4

# Inference service: llama.cpp server image + GPU passthrough + launch args. 
# Defaults below are for AMD Radeon RX 6700 XT, adjust for your hardware.
#
# Image variants (llama.cpp publishes CUDA/ROCm/Vulkan/CPU builds)
INFERENCE_IMAGE=ghcr.io/ggml-org/llama.cpp:server-rocm
# GPU passthrough, one variable per devices/group_add array entry in compose.
GPU_DEVICE_1=/dev/kfd
GPU_DEVICE_2=/dev/dri
GPU_GROUP_1=video
GPU_GROUP_2=render
# ROCm arch override for GPUs outside official support.
HSA_OVERRIDE_GFX_VERSION=10.3.0
INFERENCE_MODELS_DIR=./data/models
# -hf pulls the GGUF from Hugging Face on first start
INFERENCE_ARGS="-hf unsloth/Qwen3.5-9B-GGUF:Q4_K_XL --port 8080 --host 0.0.0.0 --n-gpu-layers 99 -c 12288 -fa on --cache-type-k q8_0 --cache-type-v q8_0 --jinja"
